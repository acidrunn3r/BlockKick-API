ENV=development

# Server
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Blockchain
BLOCKCHAIN_NODE_URL=http://host.docker.internal:3000
BLOCKCHAIN_REQUEST_TIMEOUT=30

# Postgres
DATABASE_URL=postgresql+asyncpg://blockkick:password@localhost:5432/blockkick_dev
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# JWT
JWT_SECRET=your-super-secret-jwt-key
# use: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
